<?xml version="1.0" encoding="utf-8"?>
<!-- Background layer for the adaptive launcher icon: vertical rose gradient
     matching the iOS app icon artwork's own top-to-bottom edge tones
     (#d25b65 top -> #b55364 bottom), so the launcher-masked corners blend
     seamlessly with the full-bleed foreground artwork. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#D25B65"
        android:endColor="#B55364"
        android:type="linear" />
</shape>